VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_USER_EMAIL=your-email-here
VITE_SUPABASE_USER_PASSWORD=your-password-here

# MCP server also reads the VITE_ prefixed vars above via dotenv.
# If running the MCP server outside the project root, set these instead:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_USER_EMAIL=your-email-here
# SUPABASE_USER_PASSWORD=your-password-here
