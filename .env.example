# Supabase project. The URL and anon key are public-safe (Supabase
# designs the anon key to be exposed in clients), but only the main
# process reads them so they don't need any prefix at all.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Login credentials. Do NOT prefix these with VITE_ — Vite would inline
# any VITE_-prefixed variable into the renderer bundle, which would ship
# your password inside the packaged app. The main process reads these
# at runtime via fs, so a plain prefix-less name is correct.
SUPABASE_USER_EMAIL=your-email-here
SUPABASE_USER_PASSWORD=your-password-here
