{
  "name": "ul-temenos-v2",
  "version": "0.1.0",
  "description": "A writing app with a live AI feedback partner",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "publish": "electron-vite build && electron-builder --mac --publish always",
    "test": "tsx --test src/renderer/src/lib/autosaveConfig.test.ts",
    "mcp:dev": "tsx src/mcp/server.ts"
  },
  "build": {
    "appId": "com.deshpanderitwik.ul-temenos-v2",
    "productName": "UL Temenos",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity"
    },
    "publish": {
      "provider": "github",
      "owner": "deshpanderitwik",
      "repo": "ul-temenos-v2"
    }
  },
  "dependencies": {
    "@fontsource-variable/work-sans": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "electron-updater": "^6.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.0.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
